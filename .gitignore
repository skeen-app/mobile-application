# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Per-developer overrides for --dart-define-from-file (env.json is the
# committed default; env.local.json holds machine-specific values like
# localhost / 10.0.2.2 emulator URLs and stays untracked).
env.local.json
env.json

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

web/
.idea/

# Firebase mobile app config — contains the Web API key + project IDs.
# Each developer downloads it from Firebase Console.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
firebase_options.dart
lib/firebase_options.dart